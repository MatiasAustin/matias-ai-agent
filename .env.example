# ==============================================================================
# MATIAS AI STUDIO OS - ENVIRONMENT CONFIGURATION
# Copy this file to .env locally and add these variables to Vercel Project Settings
# ==============================================================================

# Supabase PostgreSQL Configuration
# 1. Create a project at https://supabase.com
# 2. In Supabase Dashboard -> Project Settings -> API, find your URL and Service Role Key
# 3. In Supabase SQL Editor, run the script in supabase/schema.sql
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional: Override default seed credentials
SUPER_ADMIN_PASSWORD=Admin123!
OWNER_PASSWORD=Owner123!
MEMBER_PASSWORD=Member123!
